{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kyu Terminal",
  "mainBinaryName": "kyu",
  "version": "0.5.0",
  "identifier": "com.derkyu.kyu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kyu Terminal",
        "width": 1200,
        "height": 740,
        "minWidth": 480,
        "minHeight": 280,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0b0d",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "publisher": "Alex (Derky)",
    "license": "MIT",
    "shortDescription": "Terminal con Claude Code integrado",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQjI2NzBDNDZGRjE3RTkKUldUcEYvOUdER2V5T3dtYVdZbnc0bStsdHJDQy9jaU5qVi91ZmtkREZmODAySGNpY1JUVDZJMDMK",
      "endpoints": [
        "https://github.com/IsDerky/kyu-terminal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
